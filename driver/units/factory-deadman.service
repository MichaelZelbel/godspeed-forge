[Unit]
Description=Factory dead-man: an approved release that does not move, or a driver that stopped, is told to the owner (plain files only, no driver code)

[Service]
Type=oneshot
Environment=HOME=/root LANG=C.UTF-8
EnvironmentFile={{ENV_FILE}}
ExecStart=/usr/bin/flock -n /run/factory-deadman.flock {{NODE}} {{KEEPER_DIR}}/deadman.mjs
{{DEADMAN_STATE_DIRECTORY}}TimeoutStartSec=120
