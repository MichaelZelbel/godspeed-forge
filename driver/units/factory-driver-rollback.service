[Unit]
Description=Factory driver keeper: counts a failed round (3 in a row on a newer set put last-good back)
# Started by factory-driver.service's OnFailure= (drop-in factory-driver.service.d/keeper.conf). It holds the driver's
# round lock while it restores, so no round starts on a half-restored set.

[Service]
Type=oneshot
Environment=HOME=/root LANG=C.UTF-8
EnvironmentFile={{ENV_FILE}}
ExecStart={{NODE}} {{KEEPER_DIR}}/keeper.mjs failed
TimeoutStartSec=900
