{
  "_about": "The only questions from the factory that stop anything and page the owner (2026-11-24, the owner's standing instruction: 'only do this for life-or-death questions'). A question pages only when the action Mission Control would take for it (the manager's recommendation, or with none the most reversible option; with nothing to pick from, the question itself) matches a pattern below that no negation just before it ('do not', 'never', 'without', 'instead of', ...) turns around. Everything else (scope, mission, look and feel, product behaviour, wording, privacy-facing behaviour, tests, checks, laps) is decided by Mission Control at once. Patterns are JavaScript regular expressions, matched case-insensitively. Publishing legal or privacy text is already behind the owner's release go, so wording is not here.",
  "money": {
    "why": "it would spend money or raise a spending limit, subscription or paid plan",
    "patterns": [
      "\\bspend(?:s|ing)? (?:money|more|\\$|€|£|\\d|on )",
      "\\bpay (?:for|\\$|€|£|\\d|more|the (?:invoice|bill|fee))",
      "\\bpayment of\\b",
      "\\bpaid (?:plan|tier|account|version|service|subscription|add-on|seat)",
      "\\bpurchas(?:e|es|ing) (?:a|an|the|more|extra|another|credits?|seats?|licen[cs]es?)\\b",
      "\\bbuy(?:s|ing)? (?:a|an|the|more|extra|another|credits?|seats?|licen[cs]es?|tokens?)\\b",
      "\\b(?:start|take out|upgrade|renew|raise|add|buy) (?:a |the |our |its |another )?(?:paid |new |bigger )?subscriptions?\\b",
      "\\bsubscribe to\\b",
      "\\bbilling (?:plan|account|tier|limit|cap)\\b",
      "\\b(?:monthly|spend(?:ing)?|key|credit|usage|account|budget|billing|rate)(?:'s)? (?:monthly )?(?:limit|cap|quota)\\b",
      "\\b(?:raise|increase|lift|bump|double|extend) (?:the |our |its |a |his |her |their )?(?:\\w+(?:'s)? ){0,2}(?:limit|cap|budget|quota|allowance)\\b",
      "\\b(?:upgrade|raise|move) (?:the |our |its )?(?:\\w+ )?(?:plan|tier) to\\b",
      "\\bupgrade (?:to )?(?:the |a )?(?:paid|pro|team|business|bigger|higher) (?:plan|tier)\\b",
      "\\btop(?:-| )?up\\b",
      "\\b(?:spend|use|put|commit|invest)(?:s|ing)? (?:\\w+ ){0,2}money\\b",
      "[$€£]\\s?\\d",
      "\\d\\s?(?:usd|eur|gbp|dollars?|euros?)\\b"
    ]
  },
  "publish": {
    "why": "it would publish something, put it live, or send something to people other than the owner",
    "patterns": [
      "\\bpublish(?:es|ed|ing)?\\b(?! (?:button|buttons|date|dates|status|flag|state|setting|settings|toggle|icon|menu|page|form|field|tab|step|action|permission)s?\\b)",
      "\\bgo(?:es)? live\\b",
      "\\bput (?:it |this |them )?live\\b",
      "\\bmake (?:it |this |them |the \\w+ )?public\\b",
      "\\bpublic release\\b",
      "\\breleased? (?:it |this )?publicly\\b",
      "\\bpost(?:s|ed|ing)? (?:it |this |them )?(?:publicly|in public|on (?:social media|linkedin|x|twitter|facebook|instagram|reddit|youtube|tiktok|mastodon|bluesky|hacker news))",
      "\\bannounce(?:s|d)? (?:it |this |them |the \\w+ )?(?:publicly|to (?:users|customers|everyone|the public|subscribers|members))",
      "\\bpublic announcement\\b",
      "\\b(?:send|email|e-mail|mail)(?:s|ed|ing)? (?:out )?(?:the |a |our |this )?newsletter\\b",
      "\\bpress release\\b",
      "\\b(?:email|e-mail|mail|message|notify|write to|text|contact) (?:all |the |our |every |each |existing )?(?:users|customers|subscribers|members|clients|mailing list|list|people on)\\b",
      "\\bsend (?:\\w+ ){0,3}to (?:all |the |our |every |each |existing )?(?:users|customers|subscribers|members|clients|mailing list|people)\\b",
      "\\binvit(?:e|es|ing|ations?) (?:\\w+ ){0,2}(?:users|customers|people|members|clients|testers|subscribers)\\b",
      "\\bdeploy(?:s|ed|ing)? (?:it |this )?(?:to|on) (?:production|the public|the live)",
      "\\b(?:submit|publish|release|upload|ship|put|launch|list)(?:s|ted|ed|es|ing)? (?:\\w+ ){0,3}(?:to|on|in|into) (?:the |an |a |its |our |their )?(?:app|play|chrome web|microsoft|apple|google play)(?: app)? stores?\\b",
      "\\bsubmit (?:it |this )?(?:to|for) (?:review|the store|app review)",
      "\\b(?:share|post|promote|advertise|announce)(?:s|d|ed|ing)? (?:\\w+ ){0,3}(?:on|to|via|in) (?:social media|linkedin|x|twitter|facebook|instagram|reddit|youtube|tiktok|mastodon|bluesky|threads|hacker news|product hunt|discord|slack)\\b",
      "\\blaunch(?:es|ed|ing)? (?:it |this |them |the \\w+ )?(?:publicly|to the public|to (?:users|customers|everyone|subscribers))"
    ]
  },
  "delete": {
    "why": "it would irreversibly delete people's data or accounts",
    "patterns": [
      "\\b(?:permanently|irreversibly|for good) (?:delete|remove|erase|destroy)",
      "\\b(?:delete|remove|erase|destroy)s? (?:\\w+ )?(?:permanently|irreversibly|for good)\\b",
      "\\b(?:erase|wipe|purge)s? (?:all |the |every |their |its |old |inactive |existing )?(?:\\w+ )?(?:people's |users'? |user |customers'? |customer |members'? |member |person's )?(?:data|accounts?|records|profiles|history|database|backups)\\b",
      "\\b(?:delete|remove|drop) (?:all |every |the |old |inactive |existing |their |its )?(?:\\w+ )?(?:people's|users'?|user|customers'?|customer|members'?|member|persons'?|person's) (?:data|accounts?|records|profiles|notes|messages|chats|history|files)\\b",
      "\\b(?:delete|remove) (?:all|every|the|old|inactive|existing) (?:data|accounts|records|users|profiles|notes|messages|chats|backups)\\b",
      "\\bdrop (?:the )?(?:table|database|tables)\\b"
    ]
  }
}
