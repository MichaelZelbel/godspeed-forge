{
  "_about": "Placeholders only. Copy the two parts into the settings folder (root on Linux: /etc/godspeed-forge): the value of \"driver.json\" as driver.json, the value of \"projects/owner--repository.json\" as projects/<owner>--<repository>.json (one such file per repository). godspeed-forge driver install checks them and names anything missing.",
  "driver.json": {
    "owner": { "github_login": "your-github-login", "name": "Your Name", "telegram_user_ids": ["123456789"] },
    "server": {
      "factory_user": "factory", "factory_uid": 1000, "factory_gid": 1000, "factory_home": "/home/factory", "netns": "",
      "must_run_units": [], "state_dir": "/var/lib/godspeed/forge/driver", "spool_dir": "/var/lib/godspeed/forge/spool",
      "deadman_state_dir": "/var/lib/godspeed/forge/deadman", "keeper_dir": "/usr/local/lib/godspeed/forge/keeper",
      "driver_dir": "/usr/local/lib/godspeed/forge/driver", "questions_dir": "/var/lib/godspeed/forge/questions", "node": "/usr/bin/node", "name_in_messages": "Your Name"
    },
    "keys": { "env_file": "/etc/godspeed-forge/keys-file", "token_script": "/usr/local/bin/gh-app-token.mjs" },
    "notices": { "godspeed_notices_file": "/root/brain/.godspeed/notices.json", "telegram_env_file": "/root/brain/telegram.env", "watch_repo": "owner/records" },
    "ai": { "bins": { "claude": "/home/factory/.local/bin/claude", "codex": "/usr/local/bin/codex" }, "models": { "strong": "the-stronger-model" }, "openrouter_allow": [], "act_brain_dir": "/root/brain" },
    "budget": { "act_runs_per_day": 8, "reserved": 4 },
    "legacy_units": [],
