      "questions": { "godspeed_dir": "/root/brain", "hermes_home": "/root/chat-program", "to_owner_file": "to-owner.json" },
      "test-machine": { "holdout": "H-1" }
    }
  },
  "projects/owner--repository.json": {
    "repository": "owner/repository", "project": "repository", "checkout": "/home/factory/repository",
    "apps": { "builder": "your-builder-app", "release": "your-release-app" }, "trust": true,
    "questions": { "label": "the product", "name": "the product", "product": "what the software is, in a few words", "seat": "as a person who uses it", "example": "When you use it to do an everyday thing, it sometimes does something else." },
    "releases": {
      "records_repo": "owner/records", "records_checkout": "/var/lib/godspeed/forge/records", "plan_pattern": "^release-\\d", "scenarios_workflow": "scenarios.yml",
      "tools_dir": "/home/factory/holdout-tools", "holdouts_dir": "/home/factory/holdouts", "engine_repo": "", "health_url": "http://127.0.0.1:8080/health", "version_file": "/root/brain/version"
    }
  }
